# Copy to .env and adjust. .env is gitignored.

# ── OpenCode server ──────────────────────────────────────────────────────────
# The long-lived `opencode serve` this app talks to. One server hosts every
# project; the BFF selects a project per-request with ?directory=.
OPENCODE_URL=http://127.0.0.1:4096

# Basic auth, if the server was started with OPENCODE_SERVER_PASSWORD set.
# Leave unset for an unsecured (loopback- or tailnet-only) server.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# ── This app ─────────────────────────────────────────────────────────────────
# Development BFF port. The supervised production BFF defaults to :3210 so it
# cannot silently collide with `npm run dev`; the Vite dev proxy reads this value.
PORT=3000

# Root under which project folders are offered in the new-session picker. The
# server scans at most 5 levels, 5,000 directories, and 500 results.
PROJECTS_DIR=~/Documents/Projects

# Server-global ordered project pins shared by desktop and phone clients.
# PROJECT_PINS_FILE=.state/project-pins.json

# Server-global ordered model pins shared by desktop and phone clients.
# MODEL_PINS_FILE=.state/model-pins.json

# OpenCode creates isolated worktrees below this root. The BFF accepts workspace
# paths only beneath PROJECTS_DIR or this directory.
OPENCODE_WORKTREE_ROOT=~/.local/share/opencode/worktree

# ── Mobile / Tailscale (optional) ────────────────────────────────────────────
# Public HTTP(S) origin encoded by the "Open on phone" QR action. Set this to
# the Tailscale Serve URL that reaches the app; unset falls back to the browser
# origin (which is usually localhost on desktop and therefore not phone-safe).
# PUBLIC_APP_URL=https://your-device.your-tailnet.ts.net

# Vite blocks non-localhost Host headers by default (DNS-rebinding protection).
# Set to "all", or a comma-separated allowlist, to reach the dev UI from a phone.
# VITE_ALLOWED_HOSTS=all

# Ports the read-only mobile preview proxy may reach on 127.0.0.1. Unset means
# disabled. The BFF and OpenCode ports are always removed from this list.
# PREVIEW_ALLOWED_PORTS=5173,4173

# ── Live session browser (issue #229, optional, off by default) ─────────────
# Server-side Chromium streamed into a per-session drawer. The manager blocks
# loopback/private/link-local targets, file:// and downloads; the persistent
# profile (a credential store) lives under .state/ at mode 0700.
# LIVE_BROWSER_ENABLED=true
# BROWSER_MAX_PAGES=10
# BROWSER_IDLE_MINUTES=30
# BROWSER_PROFILE_DIR=.state/live-browser-profile
# BROWSER_EXECUTABLE_PATH=/path/to/chromium

# ── DeepSeek Harness experiment (optional) ──────────────────────────────────
# Install `deepseek-harness-sdk` into this Python interpreter. Enabling fails
# closed unless every preset names an explicit Cordis composition and mode and
# every workspace is server-allowlisted. The browser cannot supply raw paths.
# DSH_EXPERIMENT_ENABLED=true
# DSH_PYTHON=/absolute/path/to/dsh-venv/bin/python
# DSH_SDK_VERSION=0.1.1rc2
# DSH_PRESETS_JSON=[{"id":"openai-eu-readonly","label":"OpenAI EU read-only","provider":"openai","model":"gpt-5.6-sol","mode":"read-only","cordis":"/absolute/path/to/deploy/dsh-openai-eu.cordis.yml","sha256":"<sha256-of-cordis-file>"},{"id":"openai-eu-build","label":"OpenAI EU Build","provider":"openai","model":"gpt-5.6-sol","mode":"build","cordis":"/absolute/path/to/deploy/dsh-openai-eu.cordis.yml","sha256":"<same-sha256>"}]
# DSH_WORKSPACES_JSON=[{"id":"experiment","label":"Experiment workspace","directory":"/absolute/path/to/workspace"}]
# DSH_STATE_DIR=.state/dsh
# Provider credentials stay in this mode-0600 file; Cordis refers to the name.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Trajectory summaries are safe by default. Sensitive detail remains disabled
# unless this is explicit; full export requires both flags and in-UI confirmation.
# DSH_TRAJECTORY_SENSITIVE_ENABLED=true
# DSH_TRAJECTORY_FULL_EXPORT_ENABLED=true

# ── Notifications (optional, Phase 5) ────────────────────────────────────────
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=
# NOTIFICATION_PREFS_FILE=.state/notification-prefs.json
# Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# WEB_PUSH_SUBSCRIPTIONS_FILE=.state/web-push-subscriptions.json

# ── Audit log ────────────────────────────────────────────────────────────────
# Where launchd writes bff.launchd.{out,err}.log and where the BFF writes its
# own bounded audit.jsonl. Keep these in one place: the server resolves from
# the working directory while scripts/launchd.ts resolves relative to the repo
# root, and they coincide only because the LaunchAgent sets WorkingDirectory.
# LOG_DIR=.state/logs
# AUDIT_LOG_FILE=.state/logs/audit.jsonl
#
# Correlation IDs in the audit log are HMACs. Without a fixed key one is
# generated per process, so IDs stop joining across a restart and the durable
# log loses most of its value. Set this in any deployment you intend to read.
# Generate once with: openssl rand -hex 32
# NOTIFICATION_AUDIT_HMAC_KEY=

# ── Forge integrations (optional, Phase 3) ───────────────────────────────────
# Used by the review panel and Project Planning. Creating planning issues and
# changing their labels need Issues write access. Agent git operations still use
# host credentials directly.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# GITLAB_BASE_URL=https://gitlab.com

# ── Claude Code local-binary runtime (optional) ──────────────────────────────
# Drive the unmodified `claude` binary beside OpenCode. Non-interactive by
# design (no mid-turn approval prompt exists over stream-json). Enabling fails
# closed unless the CLI version is pinned, the binary path is absolute, and every
# preset and workspace is server-allowlisted. macOS Seatbelt is the write
# authority: read-only presets cannot write the workspace. Sign-in stays in the
# binary (its own Keychain item); this app never reads or forwards the credential.
# CLAUDE_RUNTIME_ENABLED=true
# CLAUDE_BINARY=/absolute/path/to/claude
# CLAUDE_CLI_VERSION=2.1.257
# CLAUDE_PRESETS_JSON=[{"id":"opus-readonly","label":"Opus read-only","model":"claude-opus-5","effort":"high","permissionMode":"default","mode":"read-only"},{"id":"opus-build","label":"Opus Build","model":"claude-opus-5","effort":"high","permissionMode":"acceptEdits","mode":"build","maxBudgetUsd":5}]
# CLAUDE_WORKSPACES_JSON=[{"id":"experiment","label":"Experiment workspace","directory":"/absolute/path/to/workspace"}]
# CLAUDE_STATE_DIR=.state/claude
