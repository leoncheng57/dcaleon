{
  "catalogVersion": 1,
  "schemaVersion": "persistent-side-agent-failure-scenario/v1",
  "feature": "persistent-side-agent",
  "description": "Deterministic failure and race scenarios. SSE is a nudge, transcript/store evidence is authoritative, and interrupted work is never automatically replayed.",
  "defaults": {
    "reconcileWithinMs": 15000,
    "globalConcurrency": 2,
    "automaticReplayAllowed": false,
    "uniqueOwnershipRequired": true
  },
  "states": [
    "queued",
    "submitting",
    "running",
    "answered",
    "failed",
    "cancelling",
    "cancelled",
    "interrupted"
  ],
  "scenarios": [
    {
      "id": "psa-sse-001",
      "category": "missed-sse",
      "title": "Missed completion event is repaired by polling",
      "priority": "P1",
      "ownership": { "directory": "/tmp/psa-e2e-sse-001", "specialist": "sa_sse_001" },
      "fault": { "type": "drop_events", "events": ["message.updated", "message.part.updated", "session.idle"] },
      "expectedTransitions": ["running->answered"],
      "evidence": "assistant_turn_completed",
      "invariants": ["No SSE event is required", "The question is submitted once", "Status absence is not terminal"],
      "assertions": ["Final state is answered within 15000ms", "Dispatch count is 1"]
    },
    {
      "id": "psa-bff-001",
      "category": "bff-restart",
      "title": "Restart after durable enqueue and before scheduler observation",
      "priority": "P1",
      "ownership": { "directory": "/tmp/psa-e2e-bff-001", "specialist": "sa_bff_001" },
      "fault": { "type": "process_restart", "process": "bff", "boundary": "after_queue_commit_before_dispatch" },
      "expectedTransitions": ["queued->submitting", "submitting->running"],
      "evidence": "known_never_submitted_then_prompt_accepted",
      "invariants": ["Acknowledged question survives restart", "Startup reconciliation precedes dispatch"],
      "assertions": ["Same question ID loads", "Dispatch count is 1"]
    },
    {
      "id": "psa-bff-002",
      "category": "ambiguous-acceptance",
      "title": "Restart after OpenCode acceptance and before running commit",
      "priority": "P0",
      "ownership": { "directory": "/tmp/psa-e2e-bff-002", "specialist": "sa_bff_002" },
      "fault": { "type": "process_restart", "process": "bff", "boundary": "after_prompt_204_before_state_commit" },
      "expectedTransitions": ["submitting->running"],
      "evidence": "question_marker_found_once",
      "invariants": ["Question is not resubmitted", "Exactly one marker exists"],
      "assertions": ["Dispatch count is 1", "Automatic replay count is 0"]
    },
    {
      "id": "psa-acceptance-001",
      "category": "ambiguous-acceptance",
      "title": "Transport fails without response or transcript proof",
      "priority": "P0",
      "ownership": { "directory": "/tmp/psa-e2e-acceptance-001", "specialist": "sa_acceptance_001" },
      "fault": { "type": "transport_disconnect", "boundary": "during_prompt_async", "upstreamAcceptance": "unknown" },
      "expectedTransitions": ["submitting->interrupted"],
      "evidence": "acceptance_unprovable",
      "invariants": ["No automatic replay", "Later FIFO questions remain queued", "Retry gets a new question ID"],
      "assertions": ["Final state is interrupted", "Automatic replay count is 0"]
    },
    {
      "id": "psa-opencode-001",
      "category": "opencode-restart",
      "title": "OpenCode restarts with an unfinished assistant turn",
      "priority": "P0",
      "ownership": { "directory": "/tmp/psa-e2e-opencode-001", "specialist": "sa_opencode_001" },
      "fault": { "type": "process_restart", "process": "opencode", "boundary": "after_acceptance_before_terminal_turn" },
      "expectedTransitions": ["running->interrupted"],
      "evidence": "generation_changed_with_incomplete_turn",
      "invariants": ["Status absence is not success", "No automatic replay"],
      "assertions": ["Final state is interrupted", "Explicit retry is available"]
    },
    {
      "id": "psa-opencode-002",
      "category": "opencode-restart",
      "title": "Restart after terminal transcript but before event delivery",
      "priority": "P1",
      "ownership": { "directory": "/tmp/psa-e2e-opencode-002", "specialist": "sa_opencode_002" },
      "fault": { "type": "process_restart", "process": "opencode", "boundary": "after_terminal_transcript_before_event" },
      "expectedTransitions": ["running->answered"],
      "evidence": "assistant_turn_completed",
      "invariants": ["Transcript evidence outranks status absence", "No replay"],
      "assertions": ["Final state is answered", "Dispatch count is 1"]
    },
    {
      "id": "psa-provider-001",
      "category": "provider-retry",
      "title": "Provider retry returns to running and completes",
      "priority": "P1",
      "ownership": { "directory": "/tmp/psa-e2e-provider-001", "specialist": "sa_provider_001" },
      "fault": { "type": "status_sequence", "values": ["busy", "retry", "busy", "completed"] },
      "expectedTransitions": ["running->answered"],
      "evidence": "assistant_turn_completed",
      "invariants": ["Provider retry does not create a question", "Retry does not free the child slot"],
      "assertions": ["Dispatch count is 1", "Same-child concurrency is 1"]
    },
    {
      "id": "psa-provider-002",
      "category": "provider-failure",
      "title": "Provider terminal failure is redacted",
      "priority": "P1",
      "ownership": { "directory": "/tmp/psa-e2e-provider-002", "specialist": "sa_provider_002" },
      "fault": { "type": "provider_failure", "sensitiveBody": "failed at /tmp/private with sk-secret-token" },
      "expectedTransitions": ["running->failed"],
      "evidence": "assistant_turn_error",
      "invariants": ["Sensitive body is absent from logs and API summaries", "Next question may run after terminal state"],
      "assertions": ["Final state is failed", "Error code is PSA_PROVIDER_FAILED"]
    },
    {
      "id": "psa-duplicate-001",
      "category": "duplicate-request",
      "title": "Concurrent identical idempotency keys create one question",
      "priority": "P0",
      "ownership": { "directory": "/tmp/psa-e2e-duplicate-001", "specialist": "sa_duplicate_001" },
      "fault": { "type": "concurrent_http", "count": 2, "sameKey": true, "sameInput": true },
      "expectedTransitions": ["queued->submitting"],
      "evidence": "idempotent_replay",
      "invariants": ["One durable question", "Both callers receive the same question ID", "One dispatch"],
      "assertions": ["Created question count is 1", "Dispatch count is 1"]
    },
    {
      "id": "psa-device-001",
      "category": "multi-device-race",
      "title": "Two devices mutate one delivery revision",
      "priority": "P1",
      "ownership": { "directory": "/tmp/psa-e2e-device-001", "specialist": "sa_device_001" },
      "fault": { "type": "optimistic_concurrency", "clients": ["desktop", "mobile"], "revision": 4 },
      "expectedTransitions": ["inbox->accepted"],
      "evidence": "revision_compare_and_swap",
      "invariants": ["One mutation commits", "Stale device receives current state", "No duplicate parent attachment"],
      "assertions": ["Success count is 1", "Conflict status is 409"]
    },
    {
      "id": "psa-cancel-001",
      "category": "cancellation-race",
      "title": "Queued cancellation wins before dispatch",
      "priority": "P1",
      "ownership": { "directory": "/tmp/psa-e2e-cancel-001", "specialist": "sa_cancel_001" },
      "fault": { "type": "scheduler_cancel_race", "winner": "cancellation" },
      "expectedTransitions": ["queued->cancelled"],
      "evidence": "cancelled_before_dispatch",
      "invariants": ["No prompt", "No abort", "Next question remains eligible"],
      "assertions": ["Dispatch count is 0", "Final state is cancelled"]
    },
    {
      "id": "psa-cancel-002",
      "category": "cancellation-race",
      "title": "Answer wins concurrently with abort",
      "priority": "P0",
      "ownership": { "directory": "/tmp/psa-e2e-cancel-002", "specialist": "sa_cancel_002" },
      "fault": { "type": "abort_completion_race", "winner": "answer" },
      "expectedTransitions": ["running->cancelling", "cancelling->answered"],
      "evidence": "assistant_turn_completed_before_cancel_settlement",
      "invariants": ["Terminal transcript evidence wins", "Result is not labelled cancelled"],
      "assertions": ["Final state is answered", "Race winner is answer"]
    },
    {
      "id": "psa-store-001",
      "category": "corrupt-store",
      "title": "Malformed durable state fails closed",
      "priority": "P0",
      "ownership": { "store": "/tmp/psa-e2e-store-001.json" },
      "fault": { "type": "store_corruption", "value": "malformed_json" },
      "expectedTransitions": [],
      "evidence": "store_validation_failed",
      "invariants": ["Source is preserved", "Feature is degraded read-only", "No dispatch"],
      "assertions": ["Store health is false", "Error code is PSA_STORE_CORRUPT"]
    },
    {
      "id": "psa-store-002",
      "category": "store-write-failure",
      "title": "Store failure prevents upstream side effect",
      "priority": "P0",
      "ownership": { "store": "/tmp/psa-e2e-store-002.json" },
      "fault": { "type": "filesystem_failure", "operation": "rename", "boundary": "persist_submitting" },
      "expectedTransitions": [],
      "evidence": "store_write_failed",
      "invariants": ["OpenCode is not called", "Durable question remains queued", "Scheduler pauses"],
      "assertions": ["Dispatch count is 0", "Error code is PSA_STORE_WRITE_FAILED"]
    },
    {
      "id": "psa-starvation-001",
      "category": "starvation",
      "title": "Busy specialist cannot starve another specialist",
      "priority": "P1",
      "ownership": { "directory": "/tmp/psa-e2e-starvation-001", "specialists": ["sa_hot", "sa_waiting"] },
      "fault": { "type": "queue_pressure", "hotDepth": 20, "waitingDepth": 1, "globalConcurrency": 1 },
      "expectedTransitions": ["queued->submitting"],
      "evidence": "round_robin_selection",
      "invariants": ["FIFO within specialist", "Scheduler rotates specialists", "Waiting specialist runs before hot queue drains"],
      "assertions": ["Waiting specialist dispatch position is at most 2", "Same-child concurrency is 1"]
    },
    {
      "id": "psa-e2e-ownership-001",
      "category": "parallel-e2e-ownership",
      "title": "Parallel spec files cannot reset shared side-agent state",
      "priority": "P0",
      "ownership": { "meta": "e2e-shared-state-ownership" },
      "fault": { "type": "static_fixture_conflict", "resources": ["directory", "specialist", "question", "store", "reset_scope"] },
      "expectedTransitions": [],
      "evidence": "static_ownership_guard",
      "invariants": ["Every mutating spec owns unique keys", "Reset clears only named scope", "Unscoped reset conflicts globally"],
      "assertions": ["Static guard fails duplicate ownership", "No production fixture uses global reset"]
    },
    {
      "id": "psa-marker-001",
      "category": "duplicate-marker",
      "title": "Duplicate question marker pauses affected specialist",
      "priority": "P0",
      "ownership": { "directory": "/tmp/psa-e2e-marker-001", "specialist": "sa_marker_001" },
      "fault": { "type": "duplicate_transcript_marker", "occurrences": 2 },
      "expectedTransitions": ["submitting->interrupted"],
      "evidence": "marker_found_multiple_times",
      "invariants": ["Duplicate is not collapsed", "Specialist pauses", "No later question dispatches"],
      "assertions": ["Error code is PSA_DUPLICATE_MARKER", "Specialist state is paused"]
    }
  ]
}
