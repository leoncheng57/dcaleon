# Rippling API token (Bearer). Generate in the Rippling admin console.
# Needs read scope for the resources you want: workers, departments, teams,
# groups, leave_requests, companies, custom_fields.
RIPPLING_API_TOKEN=

# Optional. Defaults to production. Point at the sandbox to test safely:
# RIPPLING_BASE_URL=https://rest.ripplingsandboxapis.com
