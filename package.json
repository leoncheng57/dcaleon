{
  "name": "custom-dca-opencode",
  "version": "0.1.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "A custom local coding-agent IDE built on the OpenCode server API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoncheng57/custom-dca-opencode.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:preview": "VITE_PUBLIC_SIMULATOR=true vite build --base=${PREVIEW_BASE_PATH:-/}",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:ui && npm run build:server",
    "start": "node dist/server/index.js",
    "service:install": "tsx scripts/launchd.ts install",
    "service:status": "tsx scripts/launchd.ts status",
    "service:logs": "tsx scripts/launchd.ts logs",
    "service:uninstall": "tsx scripts/launchd.ts uninstall",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:host": "playwright test",
    "test:e2e:docker": "tsx scripts/e2e-docker.ts",
    "test:e2e:docker:proof": "tsx scripts/e2e-docker-proof.ts",
    "test:contract:host": "vitest run tests/host-contract.test.ts tests/launchd.test.ts tests/dev-preflight.test.ts tests/git-fixture.test.ts tests/e2e-state-files.test.ts tests/claude-seatbelt.test.ts",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "preview:package": "tsx scripts/pr-preview.ts package",
    "screenshots": "tsx scripts/run-pr-screenshots.ts",
    "screenshots:local": "npm run screenshots -- --request-file tests/fixtures/pr-screenshots.json --output-dir screenshot-output --pr-number 0 --sha local"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
    "@lezer/highlight": "^1.2.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "express": "^5.0.0",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.2",
    "next-themes": "^0.4.6",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "1.62.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.2.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
